generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum EstadoCliente {
  ACTIVO
  INACTIVO
}

enum RolUsuario {
  CLIENTE
  TECNICO
  COORDINADOR
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoContrato {
  ACTIVO
  VENCIDO
  CANCELADO
}

enum Prioridad {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

enum EstadoActivo {
  ACTIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
  DADO_DE_BAJA
}

enum EstadoConversacionChat {
  ACTIVA
  RESUELTA_SIN_TICKET
  CONVERTIDA_A_TICKET
}

enum EstadoContactoPendiente {
  RECOLECTANDO
  PENDIENTE
  CONVERTIDO
}

enum RolMensajeChat {
  USUARIO
  ASISTENTE
}

enum TipoRespuestaChecklist {
  BOOLEANO
  TEXTO
  NUMERO
  SELECCION
}

enum TipoTicket {
  CORRECTIVO
  PREVENTIVO
  INSTALACION
}

enum CategoriaSoporte {
  SOFTWARE
  // Las dos siguientes se derivan automáticamente en el wizard de creación (portal y
  // staff) a partir de qué eligió el usuario en el paso "Equipo o Sistema" — nunca se
  // le pide elegir entre estas dos y SOFTWARE a mano. SOFTWARE sigue existiendo como
  // categoría genérica/heredada para tickets de antes de este cambio y para el caso
  // "no sé cuál sistema es".
  SOFTWARE_TERCEROS
  SOFTWARE_SISTEMA
  HARDWARE
  INFRAESTRUCTURA
  // Agregadas porque "Hardware/Equipos" e "Infraestructura/Redes" eran las únicas 2
  // opciones de la rama "Equipo" en los wizards de creación — demasiado amplias para
  // reportes reales de un service desk (ej. un problema eléctrico o de impresión
  // terminaba clasificado como "Hardware" genérico).
  ELECTRICO_ENERGIA
  CLIMATIZACION
  IMPRESION
  SEGURIDAD_FISICA
}

enum EstadoSistemaSoftware {
  ACTIVO
  INACTIVO
}

enum EstadoTicket {
  ABIERTO
  ASIGNADO
  EN_DIAGNOSTICO
  ESPERANDO_REPUESTO
  EN_EJECUCION
  ESPERANDO_VALIDACION
  RESUELTO
  REABIERTO
  CERRADO
  CANCELADO
}

enum OrigenTicket {
  PORTAL
  CORREO
  TELEFONO
  PROGRAMADO
  CHATBOT
  // Ticket de instalación/entrega generado automáticamente a partir de una cotización
  // aprobada (ver crear-ticket-instalacion.ts) — nadie lo "reportó", a diferencia de
  // TELEFONO (que hoy ya se usa para toda creación manual por staff).
  SEGUIMIENTO
}

// Tareas: sub-ítems livianos dentro de un ticket (ej. "comprar licencia de Windows"),
// cada uno asignable a su propio responsable (Admin/Coordinador/Técnico) sin heredar el
// peso de un Ticket completo (SLA, wizard, checklist, evidencia) — ver TicketTarea.
enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

// Discriminador de TicketTareaActividad: permite que un cambio de estado generado por
// el sistema y un comentario escrito a mano convivan en la misma línea de tiempo de la
// tarea sin confundirse entre sí.
enum TipoActividadTarea {
  CREACION
  CAMBIO_ESTADO
  REASIGNACION
  COMENTARIO
}

enum TipoEvidencia {
  FOTO_ANTES
  FOTO_DESPUES
  DOCUMENTO
  OTRO
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Deliberadamente separado de EstadoAprobacion: ese responde "¿se aprobó el gasto?",
// este responde "¿ya se le cobró al cliente?" — son dos preguntas distintas sobre la
// misma fila (ver análisis "cómo ve Admin/Coordinador esto para cobrarle al cliente").
// Solo tiene sentido marcar FACTURADO sobre algo ya APROBADO.
enum EstadoFacturacion {
  PENDIENTE
  FACTURADO
}

// Medio externo por el que se envió un producto cotizado sin necesidad de visita
// técnica — ver Cotizacion.medioEnvio.
enum MedioEnvio {
  MENSAJERIA
  UBER
  OTRO
}

enum FrecuenciaMantenimiento {
  SEMANAL
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum EstadoPlanPreventivo {
  ACTIVO
  PAUSADO
}

// ---------- Configuración global del sistema ----------

// Singleton: siempre hay como máximo una fila, con id fijo "singleton" (no un
// @@unique sobre una columna booleana ni una tabla con una sola fila implícita) — el
// service que la lee/escribe (configuracion.service.ts) siempre apunta a ese mismo id,
// así que un upsert basta para "crear si no existe, actualizar si ya existe".
model ConfiguracionSistema {
  id String @id @default("singleton")

  // Branding / perfil de la empresa (aparece en la interfaz y en el header del PDF)
  empresaNombre    String  @default("NexIT")
  empresaRnc       String?
  // Igual que Evidencia.urlArchivo / FirmaDigital.urlFirmaImagen: guarda la KEY del
  // StorageProvider, no una URL resuelta — se resuelve al leer, nunca se persiste una
  // URL firmada que puede expirar.
  empresaLogoUrl   String?
  empresaTelefono  String?
  empresaEmail     String?
  empresaDireccion String?

  // Integraciones — webhooks salientes hacia n8n
  webhookUrl          String?
  webhookSecret       String?
  webhooksHabilitados Boolean @default(false)

  // Servidor SMTP para envío de correo
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  smtpFromEmail String?
  smtpFromName  String?
  smtpSsl       Boolean @default(true)

  // Parámetros operativos — default global de SLA para tickets sin contrato asignado,
  // y ventana de anticipación por defecto al generar tickets preventivos
  slaHorasCritica              Int @default(4)
  slaHorasAlta                 Int @default(8)
  slaHorasMedia                Int @default(24)
  slaHorasBaja                 Int @default(48)
  diasAnticipacionPreventivos  Int @default(7)
  // Mínimo de fotos "antes"/"después" que exige el paso de evidencia del wizard de
  // ejecución para poder avanzar — antes era 2 fijo en el código (MIN_FOTOS en
  // evidence-step.tsx), sin forma de ajustarlo por instalación.
  fotosMinimasEvidencia        Int @default(1)
  // Tamaño máximo (MB) por foto subida (evidencia general o por ítem de checklist) —
  // antes 8 fijo en MAX_BYTES en cada ruta de subida.
  evidenciaMaxMB               Int @default(8)
  // Ventana (días) para marcar un plan preventivo como "Próximo a vencer" en vez de
  // "Programado" — antes DIAS_VENTANA_PROXIMO fijo en lib/utils/plan-preventivo.ts.
  // Distinto de diasAnticipacionPreventivos (arriba): ese controla cuándo se GENERA el
  // ticket; este controla solo la etiqueta de vigencia mostrada en /admin/preventivos
  // y en el dashboard — pueden coincidir o no según cómo quiera operar cada instalación.
  diasVentanaProximoPreventivo Int @default(7)

  // Localización — antes hardcodeada como soles peruanos ("S/", en 9 sitios
  // distintos) y fechas en es-PE (en otros 9 sitios distintos), sin relación con el
  // país real de operación de cada instalación de NexIT.
  monedaCodigo  String @default("DOP")
  monedaSimbolo String @default("RD$")
  localeFecha   String @default("es-DO")

  // Cada cuántos segundos la campanita de notificaciones (NotificationBell) vuelve a
  // consultar el servidor mientras la pantalla está abierta — no hay WebSockets en la
  // app, así que esto es sondeo (polling) puro. Configurable en vez de fijo para poder
  // ajustar el balance "se siente en vivo" vs "no sobrecargar el servidor" sin tocar código.
  notificacionesIntervaloSegundos Int @default(30)

  // Asistente IA de soporte (chat del técnico en el wizard de ejecución, ver
  // ia.service.ts) — "ANTHROPIC" | "OPENAI" | "LOCAL". Null/deshabilitada = el panel de
  // chat ni se muestra. `iaBaseUrl` es obligatorio solo para "LOCAL" (ej. un servidor
  // Ollama/LM Studio compatible con la API de OpenAI); para "OPENAI" es un override
  // opcional (proxies, Azure OpenAI). `iaApiKey` nunca se manda de vuelta al cliente —
  // mismo patrón que smtpPass/webhookSecret.
  iaProveedor  String?
  iaApiKey     String?
  iaModelo     String?
  iaBaseUrl    String?
  iaHabilitada Boolean @default(false)

  actualizadoEn DateTime @updatedAt

  @@map("configuracion_sistema")
}

// Override del cuerpo de un mensaje que hoy viene "quemado" en el JSON de un workflow
// de n8n (ver src/server/services/plantilla-notificacion.service.ts para el catálogo
// fijo de `clave`s válidas y su texto por defecto). Una fila ausente para una `clave`
// significa "usar el texto por defecto" — nunca se borra el catálogo, solo se
// sobreescribe. El texto renderizado viaja en el payload del webhook (`data.mensaje`)
// para que n8n lo relaye tal cual, en vez de tener su propia copia del texto.
model PlantillaNotificacion {
  id            String   @id @default(cuid())
  clave         String   @unique
  cuerpo        String
  actualizadoEn DateTime @updatedAt

  @@map("plantillas_notificacion")
}

// ---------- Multi-tenant: clientes y sucursales ----------

model Cliente {
  id                   String        @id @default(cuid())
  nombre               String
  identificacionFiscal String?       @unique
  estado               EstadoCliente @default(ACTIVO)
  fechaRegistro        DateTime      @default(now())

  sucursales       Sucursal[]
  usuarios         Usuario[]
  contratos        Contrato[]
  tickets          Ticket[]
  sistemasSoftware SistemaSoftware[]

  @@map("clientes")
}

// Catálogo de sistemas/software que un cliente reporta tener instalado (ERP, sistema de
// facturación propio, etc.) — a propósito NO es un Activo: no tiene marca/modelo/número
// de serie reales que registrar, no necesita checklist de mantenimiento físico, y suele
// ser transversal a toda la empresa, no de una sola sucursal (por eso cuelga de Cliente,
// no de Sucursal, a diferencia de Activo).
model SistemaSoftware {
  id            String                @id @default(cuid())
  clienteId     String
  cliente       Cliente               @relation(fields: [clienteId], references: [id])
  nombre        String
  proveedor     String?
  estado        EstadoSistemaSoftware @default(ACTIVO)
  fechaCreacion DateTime              @default(now())

  tickets Ticket[]

  @@index([clienteId])
  @@map("sistemas_software")
}

model Sucursal {
  id               String   @id @default(cuid())
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  nombre           String
  direccion        String
  ciudad           String
  latitud          Decimal? @db.Decimal(9, 6)
  longitud         Decimal? @db.Decimal(9, 6)
  contactoNombre   String?
  contactoTelefono String?

  activos           Activo[]
  tickets           Ticket[]
  planesPreventivos PlanMantenimientoPreventivo[]

  @@index([clienteId])
  @@map("sucursales")
}

model Usuario {
  id             String        @id @default(cuid())
  nombre         String
  email          String        @unique
  passwordHash   String
  rol            RolUsuario
  clienteId      String?
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  estado         EstadoUsuario @default(ACTIVO)
  ultimoAccesoAt DateTime?

  // Vínculo self-service (/perfil) para el workflow de n8n de chat con IA: sin esto,
  // n8n no tiene forma de resolver "quién escribió este mensaje de Telegram/WhatsApp"
  // a un Usuario/Cliente de NexIT.
  telegramChatId               String? @unique
  whatsappTelefono             String? @unique
  // Algunos usuarios de WhatsApp activan la privacidad de "nombre de usuario" de Meta:
  // Twilio deja de mandar el teléfono real en el webhook y en su lugar manda un
  // identificador opaco estable (ver conversación de diseño) — se guarda acá, nunca en
  // whatsappTelefono, para no mezclar un teléfono real con algo que no lo es. Se llena
  // solo mediante el código de verificación por correo (vinculacion-identidad.service.ts).
  whatsappIdentificadorAlterno String? @unique
  // Puramente informativo (el @usuario de WhatsApp que esa persona eligió) — nunca se
  // usa para buscar/matchear, solo ayuda a un humano a reconocer de quién se trata.
  whatsappUsername             String?

  ticketsCreados             Ticket[]                      @relation("TicketCreador")
  ticketsAsignados           Ticket[]                      @relation("TicketTecnico")
  historial                  TicketHistorial[]
  evidencias                 Evidencia[]
  repuestosAprobados         TicketRepuesto[]              @relation("RepuestoAprobador")
  cotizacionesAprobadas      Cotizacion[]                  @relation("CotizacionAprobador")
  planesPreventivos          PlanMantenimientoPreventivo[]
  movimientosInventario      MovimientoInventario[]
  registrosAuditoria         RegistroAuditoria[]
  conversacionesChat         ConversacionChat[]
  contactosPendientesCreados ContactoPendiente[]
  notificaciones             Notificacion[]
  verificacionesIdentidad    VerificacionIdentidadChat[]
  especialidades             UsuarioEspecialidad[]
  ticketsColaborador         TicketColaborador[]
  tareasCreadas              TicketTarea[]                 @relation("TareaCreador")
  tareasAsignadas            TicketTarea[]                 @relation("TareaAsignada")
  tareaActividades           TicketTareaActividad[]
  tareaMenciones             TicketTareaMencion[]

  @@index([clienteId])
  @@map("usuarios")
}

// ---------- Contratos y SLA ----------

model Contrato {
  id             String         @id @default(cuid())
  clienteId      String
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  tipoContrato   String
  fechaInicio    DateTime
  fechaFin       DateTime?
  horasIncluidas Int?
  estado         EstadoContrato @default(ACTIVO)

  slas ContratoSla[]

  @@index([clienteId])
  @@map("contratos")
}

model ContratoSla {
  id                  String    @id @default(cuid())
  contratoId          String
  contrato            Contrato  @relation(fields: [contratoId], references: [id])
  prioridad           Prioridad
  tiempoRespuestaMin  Int
  tiempoResolucionMin Int

  tickets Ticket[]

  @@unique([contratoId, prioridad])
  @@map("contrato_sla")
}

// ---------- Activos ----------

model CategoriaActivo {
  id     String @id @default(cuid())
  nombre String @unique

  activos            Activo[]
  checklistTemplates ChecklistTemplate[]

  @@map("categorias_activo")
}

// Catálogo gestionable desde /admin/configuracion ("Especialidades") — reemplaza el
// viejo Usuario.especialidad de texto libre para que un técnico pueda tener varias, de
// una lista consistente (evita "Redes"/"redes"/"Red" como 3 cosas distintas).
model Especialidad {
  id     String @id @default(cuid())
  nombre String @unique

  usuarios UsuarioEspecialidad[]

  @@map("especialidades")
}

// Tabla de unión explícita (no m2m implícito de Prisma) para no depender de que la
// convención de nombres/columnas que Prisma genera para un m2m implícito coincida con
// una migración escrita a mano — mismo criterio que TicketRepuesto/MovimientoInventario.
model UsuarioEspecialidad {
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  especialidadId String
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])

  @@id([usuarioId, especialidadId])
  @@map("usuarios_especialidades")
}

model Activo {
  id                  String          @id @default(cuid())
  sucursalId          String
  sucursal            Sucursal        @relation(fields: [sucursalId], references: [id])
  categoriaId         String
  categoria           CategoriaActivo @relation(fields: [categoriaId], references: [id])
  marca               String
  modelo              String
  numeroSerie         String
  fechaInstalacion    DateTime?
  fechaFinGarantia    DateTime?
  ubicacionEspecifica String?
  estado              EstadoActivo    @default(ACTIVO)

  tickets           Ticket[]
  planesPreventivos PlanMantenimientoPreventivo[]

  @@unique([sucursalId, numeroSerie])
  @@index([categoriaId])
  @@map("activos")
}

// ---------- Checklists ----------

model ChecklistTemplate {
  id                String          @id @default(cuid())
  categoriaActivoId String
  categoriaActivo   CategoriaActivo @relation(fields: [categoriaActivoId], references: [id])
  nombre            String
  version           Int             @default(1)

  items ChecklistItemTemplate[]

  @@index([categoriaActivoId])
  @@map("checklist_templates")
}

model ChecklistItemTemplate {
  id                     String                 @id @default(cuid())
  templateId             String
  template               ChecklistTemplate      @relation(fields: [templateId], references: [id])
  descripcion            String
  tipoRespuesta          TipoRespuestaChecklist
  opciones               String[]               @default([]) // solo aplica cuando tipoRespuesta = SELECCION
  orden                  Int
  observacionObligatoria Boolean                @default(false) // exige observación cuando la respuesta señala una falla (ej. BOOLEANO=NO)

  respuestas TicketChecklistRespuesta[]

  @@index([templateId])
  @@map("checklist_item_templates")
}

// El checklist a aplicar en cada ticket generado se deriva de activo.categoriaId al
// momento de generar el ticket (misma resolución que usa la pantalla de ejecución:
// última versión del ChecklistTemplate de esa categoría) — por eso este modelo no
// guarda su propio checklistTemplateId, evitando que quede desincronizado si la
// plantilla de la categoría cambia de versión entre una ejecución y la siguiente.
model PlanMantenimientoPreventivo {
  id                       String                  @id @default(cuid())
  activoId                 String?
  activo                   Activo?                 @relation(fields: [activoId], references: [id])
  sucursalId               String?
  sucursal                 Sucursal?               @relation(fields: [sucursalId], references: [id])
  titulo                   String
  descripcion              String?
  frecuencia               FrecuenciaMantenimiento
  fechaUltimoMantenimiento DateTime?
  proximaFecha             DateTime
  tecnicoAsignadoId        String?
  tecnicoAsignado          Usuario?                @relation(fields: [tecnicoAsignadoId], references: [id])
  prioridad                Prioridad               @default(MEDIA)
  estado                   EstadoPlanPreventivo    @default(ACTIVO)

  ticketsGenerados Ticket[]

  @@index([activoId])
  @@index([sucursalId])
  @@index([proximaFecha])
  @@map("planes_mantenimiento_preventivo")
}

// ---------- Tickets ----------

model Ticket {
  id                      String                       @id @default(cuid())
  numeroTicket            String                       @unique
  clienteId               String
  cliente                 Cliente                      @relation(fields: [clienteId], references: [id])
  sucursalId              String
  sucursal                Sucursal                     @relation(fields: [sucursalId], references: [id])
  activoId                String?
  activo                  Activo?                      @relation(fields: [activoId], references: [id])
  sistemaSoftwareId       String?
  sistemaSoftware         SistemaSoftware?             @relation(fields: [sistemaSoftwareId], references: [id])
  planPreventivoId        String?
  planPreventivo          PlanMantenimientoPreventivo? @relation(fields: [planPreventivoId], references: [id])
  tipo                    TipoTicket
  categoriaSoporte        CategoriaSoporte
  prioridad               Prioridad
  estado                  EstadoTicket                 @default(ABIERTO)
  titulo                  String
  descripcion             String
  // Solo la puebla el asistente de IA conversacional (origen=CHATBOT) al crear el
  // ticket — una sugerencia informativa para que el técnico llegue con contexto, nunca
  // un diagnóstico del cliente ni un paso que haya bloqueado la creación del ticket.
  // Visible solo para staff/técnico (nunca en el portal del cliente).
  sugerenciaIA            String?
  // El técnico puede marcar que este ticket puntual no requiere evidencia fotográfica
  // (no todo soporte deja algo fotografiable) — motivo obligatorio, queda auditable en
  // TicketHistorial. finalizar-visita.ts salta el mínimo de fotos cuando esto es true;
  // subir una foto igual (registrar evidencia) lo vuelve a poner en false.
  evidenciaNoAplica       Boolean                      @default(false)
  evidenciaNoAplicaMotivo String?
  creadoPorId             String
  creadoPor               Usuario                      @relation("TicketCreador", fields: [creadoPorId], references: [id])
  tecnicoAsignadoId       String?
  tecnicoAsignado         Usuario?                     @relation("TicketTecnico", fields: [tecnicoAsignadoId], references: [id])
  slaId                   String?
  sla                     ContratoSla?                 @relation(fields: [slaId], references: [id])
  origen                  OrigenTicket                 @default(PORTAL)
  fechaCreacion           DateTime                     @default(now())
  fechaAsignacion         DateTime?
  fechaInicioAtencion     DateTime?
  fechaResolucion         DateTime?
  fechaCierre             DateTime?
  // Se setea al pasar a REABIERTO (el cliente rechazó la visita) — calcularEstadoSla/
  // cumplioSla la usan como punto de partida en vez de fechaCreacion cuando existe, para
  // que el SLA no aparezca "vencido" al instante por tiempo ya consumido en un ciclo
  // anterior ya cerrado. null mientras el ticket nunca se reabrió.
  fechaReapertura         DateTime?

  historial           TicketHistorial[]
  checklistRespuestas TicketChecklistRespuesta[]
  evidencias          Evidencia[]
  firmas              FirmaDigital[]
  repuestos           TicketRepuesto[]
  cotizaciones        Cotizacion[]
  conversacionChat    ConversacionChat?
  conversacionIA      ConversacionTicketIA?
  contactoPendiente   ContactoPendiente?
  notificaciones      Notificacion[]
  colaboradores       TicketColaborador[]
  tareas              TicketTarea[]
  // Lado inverso de Cotizacion.ticketInstalacionId — este ticket existe porque se
  // generó a partir de esa cotización aprobada en otro ticket.
  cotizacionInstalacionDe Cotizacion?              @relation("CotizacionTicketInstalacion")

  @@index([clienteId, estado])
  @@index([tecnicoAsignadoId, estado])
  @@index([fechaCreacion])
  @@map("tickets")
}

// Opción A del análisis "¿un ticket puede tener varios técnicos?": tecnicoAsignadoId
// sigue siendo EL responsable (dueño del ticket — notificaciones, PDF del informe de
// servicio, alertas de SLA y el canal de n8n siguen hablando de un solo técnico, sin
// cambios). Esto es solo gente adicional que puede ENTRAR al wizard de ejecución y
// ayudar con los pasos — ver ticket-acceso.service.ts, que es el único lugar que decide
// "quién puede tocar este ticket" (responsable O colaborador).
model TicketColaborador {
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  creadoEn  DateTime @default(now())

  @@id([ticketId, usuarioId])
  @@map("ticket_colaboradores")
}

// Sub-ítem liviano dentro de un ticket (ver análisis "Tareas dentro de un ticket") — sin
// clienteId propio: el aislamiento multi-tenant lo hereda de ticket.clienteId, igual que
// Cotizacion y TicketHistorial. No bloquea el cierre del ticket ni tiene SLA propio; es
// organización interna del trabajo, no un nuevo flujo de atención.
model TicketTarea {
  id              String      @id @default(cuid())
  ticketId        String
  ticket          Ticket      @relation(fields: [ticketId], references: [id])
  titulo          String
  estado          EstadoTarea @default(PENDIENTE)
  asignadoAId     String?
  asignadoA       Usuario?    @relation("TareaAsignada", fields: [asignadoAId], references: [id])
  creadoPorId     String
  creadoPor       Usuario     @relation("TareaCreador", fields: [creadoPorId], references: [id])
  fechaCreacion   DateTime    @default(now())
  fechaCompletada DateTime?

  actividad TicketTareaActividad[]

  @@index([ticketId])
  @@index([asignadoAId])
  @@map("ticket_tareas")
}

// Línea de tiempo de una tarea puntual — mismo molde que TicketHistorial (estado
// anterior/nuevo + comentario libre) con un discriminador `tipo` para que los cambios
// generados por el sistema (CAMBIO_ESTADO, REASIGNACION) convivan con comentarios
// escritos a mano (COMENTARIO) sin confundirse.
model TicketTareaActividad {
  id             String             @id @default(cuid())
  tareaId        String
  tarea          TicketTarea        @relation(fields: [tareaId], references: [id])
  usuarioId      String
  usuario        Usuario            @relation(fields: [usuarioId], references: [id])
  tipo           TipoActividadTarea
  comentario     String?
  // Key del storage (igual que Evidencia.urlArchivo — nunca una URL ya resuelta). Solo
  // aplica a tipo COMENTARIO; una foto por comentario en v1.
  fotoArchivo    String?
  estadoAnterior String?
  estadoNuevo    String?
  fecha          DateTime           @default(now())

  menciones TicketTareaMencion[]

  @@index([tareaId])
  @@map("ticket_tarea_actividad")
}

// A quién se mencionó con "@" en un comentario puntual — mismo molde que
// TicketColaborador (par actividad+usuario). Mencionar a alguien lo da de alta como
// TicketColaborador si todavía no tenía acceso al ticket (ver notificacion.service.ts).
model TicketTareaMencion {
  actividadId String
  actividad   TicketTareaActividad @relation(fields: [actividadId], references: [id])
  usuarioId   String
  usuario     Usuario              @relation(fields: [usuarioId], references: [id])

  @@id([actividadId, usuarioId])
  @@map("ticket_tarea_menciones")
}

model TicketHistorial {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id])
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  estadoAnterior String?
  estadoNuevo    String
  comentario     String?
  fecha          DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_historial")
}

model TicketChecklistRespuesta {
  id              String                @id @default(cuid())
  ticketId        String
  ticket          Ticket                @relation(fields: [ticketId], references: [id])
  checklistItemId String
  checklistItem   ChecklistItemTemplate @relation(fields: [checklistItemId], references: [id])
  respuesta       String
  observacion     String?
  // Key del storage (igual que Evidencia.urlArchivo — nunca una URL ya resuelta), no un
  // FK a Evidencia: es una foto de ESE ítem puntual del checklist, no una evidencia
  // general antes/después del ticket.
  fotoArchivo     String?

  @@unique([ticketId, checklistItemId])
  @@map("ticket_checklist_respuestas")
}

model Evidencia {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id])
  tipo       TipoEvidencia
  urlArchivo String
  usuarioId  String
  usuario    Usuario       @relation(fields: [usuarioId], references: [id])
  fechaCarga DateTime      @default(now())

  @@index([ticketId])
  @@map("evidencias")
}

model FirmaDigital {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id])
  nombreFirmante String
  cargoFirmante  String?
  urlFirmaImagen String
  ipDispositivo  String?
  fecha          DateTime @default(now())

  @@index([ticketId])
  @@map("firmas_digitales")
}

// ---------- Repuestos, inventario y cotizaciones ----------

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
  CONSUMO_TICKET
}

model Repuesto {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nombre       String
  descripcion  String?
  marca        String?
  stockActual  Int      @default(0)
  stockMinimo  Int      @default(0)
  unidadMedida String
  costoUnidad  Decimal  @db.Decimal(10, 2)
  // Lo que se le cobra al cliente (margen sobre costoUnidad) — null = sin definir,
  // se usa costoUnidad como precio (ver crear-cotizacion.ts). Se define una vez acá,
  // no cotización por cotización.
  precioVenta  Decimal? @db.Decimal(10, 2)
  ubicacion    String?

  consumos     TicketRepuesto[]
  movimientos  MovimientoInventario[]
  cotizaciones Cotizacion[]

  @@map("repuestos")
}

// `cantidad` viaja con signo: positivo para ENTRADA, negativo para SALIDA/CONSUMO_TICKET;
// AJUSTE puede ser cualquiera de los dos (una corrección de conteo físico). El saldo del
// Kardex es la suma acumulada de `cantidad` en orden cronológico — nunca se recalcula
// aparte de `Repuesto.stockActual`, que es la fuente de verdad actualizada en cada
// movimiento dentro de la misma transacción.
model MovimientoInventario {
  id               String                   @id @default(cuid())
  repuestoId       String
  repuesto         Repuesto                 @relation(fields: [repuestoId], references: [id])
  tipo             TipoMovimientoInventario
  cantidad         Int
  motivo           String?
  usuarioId        String
  usuario          Usuario                  @relation(fields: [usuarioId], references: [id])
  ticketRepuestoId String?                  @unique
  ticketRepuesto   TicketRepuesto?          @relation(fields: [ticketRepuestoId], references: [id])
  fecha            DateTime                 @default(now())

  @@index([repuestoId, fecha])
  @@map("movimientos_inventario")
}

model TicketRepuesto {
  id               String            @id @default(cuid())
  ticketId         String
  ticket           Ticket            @relation(fields: [ticketId], references: [id])
  repuestoId       String
  repuesto         Repuesto          @relation(fields: [repuestoId], references: [id])
  cantidad         Int
  costoTotal       Decimal           @db.Decimal(10, 2)
  aprobadoPorId    String?
  aprobadoPor      Usuario?          @relation("RepuestoAprobador", fields: [aprobadoPorId], references: [id])
  estadoAprobacion EstadoAprobacion  @default(PENDIENTE)
  // Solo relevante cuando estadoAprobacion = APROBADO (hubo consumo real) — ver
  // /admin/facturacion y marcar-facturacion-repuesto.ts.
  estadoFacturacion EstadoFacturacion @default(PENDIENTE)

  movimientoInventario MovimientoInventario?

  @@index([ticketId])
  @@map("ticket_repuestos")
}

model Cotizacion {
  id            String            @id @default(cuid())
  ticketId      String
  ticket        Ticket            @relation(fields: [ticketId], references: [id])
  monto         Decimal           @db.Decimal(10, 2)
  descripcion   String
  estado        EstadoAprobacion  @default(PENDIENTE)
  aprobadoPorId String?
  aprobadoPor   Usuario?          @relation("CotizacionAprobador", fields: [aprobadoPorId], references: [id])
  fecha         DateTime          @default(now())
  // Ancla el monto a un precio real del catálogo — nunca viaja desde el cliente, se
  // recalcula server-side contra precioVenta (o costoUnidad si no hay) × cantidad al
  // crear la cotización (ver análisis "¿de dónde sale el monto de la cotización?").
  // null cuando es de tipo libre (algo que no es un producto puntual, ej. horas de
  // mano de obra adicional).
  repuestoId    String?
  repuesto      Repuesto?         @relation(fields: [repuestoId], references: [id])
  cantidad      Int?
  // Solo relevante cuando estado = APROBADO — ver /admin/facturacion y
  // marcar-facturacion-cotizacion.ts.
  estadoFacturacion EstadoFacturacion @default(PENDIENTE)
  // Ticket de instalación/entrega generado a partir de esta cotización (cuando es de
  // tipo producto y ya se aprobó) — único para no poder crear dos tickets de
  // seguimiento para la misma cotización. Ver crear-ticket-instalacion.ts.
  ticketInstalacionId String?  @unique
  ticketInstalacion   Ticket?  @relation("CotizacionTicketInstalacion", fields: [ticketInstalacionId], references: [id])
  // Alternativa a ticketInstalacionId: cuando el producto no necesita visita técnica,
  // se envía por un medio externo y se deja constancia de cómo. Mutuamente excluyente
  // con ticketInstalacionId — una cotización de producto aprobada se resuelve de una
  // forma o de la otra, nunca las dos. Ver marcar-envio-cotizacion.ts.
  medioEnvio    MedioEnvio?
  detalleEnvio  String?
  enviadoEn     DateTime?

  @@index([ticketId])
  @@map("cotizaciones")
}

// ---------- Logs / eventos del sistema ----------

// Quién hizo qué sobre entidades administrativas (usuarios, clientes, sucursales,
// activos, configuración) — el ciclo de vida de un Ticket ya tiene su propio historial
// dedicado en TicketHistorial, así que ESTE registro no duplica altas/bajas de tickets,
// solo las acciones que hoy no dejaban ningún rastro de "quién" las hizo.
// usuarioNombre/usuarioRol quedan congelados al momento del evento (no se leen desde
// la relación) para que el registro siga siendo legible aunque el usuario cambie de rol
// o de nombre después.
model RegistroAuditoria {
  id            String     @id @default(cuid())
  usuarioId     String?
  usuario       Usuario?   @relation(fields: [usuarioId], references: [id])
  usuarioNombre String
  usuarioRol    RolUsuario
  accion        String
  entidad       String
  entidadId     String?
  detalle       String?
  createdAt     DateTime   @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("registros_auditoria")
}

// Errores técnicos que antes solo llegaban a console.error (visibles únicamente con
// `docker logs`) — centralizados acá para poder revisarlos desde /admin/logs sin
// acceso a la terminal del servidor.
model RegistroError {
  id        String   @id @default(cuid())
  origen    String
  mensaje   String
  stack     String?
  contexto  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("registros_error")
}

// ---------- Asistente de IA por chat (cliente) ----------

// El estado de la conversación vive en NexIT, no en n8n: cada mensaje de Telegram/
// WhatsApp dispara una ejecución de workflow SEPARADA y sin memoria propia — sin esto,
// la IA no tendría forma de "recordar" lo que el cliente ya contó en el mensaje
// anterior. `canal`/`identificador` (no una relación directa a un ticket) identifican
// a quién pertenece, porque la conversación empieza ANTES de que exista un ticket.
model ConversacionChat {
  id            String                 @id @default(cuid())
  usuarioId     String
  usuario       Usuario                @relation(fields: [usuarioId], references: [id])
  canal         String
  identificador String
  estado        EstadoConversacionChat @default(ACTIVA)
  ticketId      String?                @unique
  ticket        Ticket?                @relation(fields: [ticketId], references: [id])
  createdAt     DateTime               @default(now())
  actualizadaAt DateTime               @updatedAt

  mensajes MensajeConversacion[]

  @@index([usuarioId, estado])
  @@map("conversaciones_chat")
}

model MensajeConversacion {
  id             String           @id @default(cuid())
  conversacionId String
  conversacion   ConversacionChat @relation(fields: [conversacionId], references: [id])
  rol            RolMensajeChat
  contenido      String
  createdAt      DateTime         @default(now())

  @@index([conversacionId])
  @@map("mensajes_conversacion")
}

// Hilo de chat entre el técnico y el Asistente IA de Soporte, uno por ticket (ver
// ia-chat-panel.tsx — acordeón integrado al wizard de ejecución, nunca una pantalla
// aparte). Reusa RolMensajeChat (USUARIO/ASISTENTE) en vez de un enum propio.
model ConversacionTicketIA {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())

  mensajes MensajeTicketIA[]

  @@map("conversaciones_ticket_ia")
}

model MensajeTicketIA {
  id             String               @id @default(cuid())
  conversacionId String
  conversacion   ConversacionTicketIA @relation(fields: [conversacionId], references: [id])
  rol            RolMensajeChat
  contenido      String
  // Como mucho un mensaje ASISTENTE marcado por conversación — marcar-respuesta-ia-
  // valida.ts desmarca cualquier otro antes de marcar este, nunca hay dos a la vez.
  esSolucion     Boolean              @default(false)
  createdAt      DateTime             @default(now())

  @@index([conversacionId])
  @@map("mensajes_ticket_ia")
}

// Captura de datos cuando escribe por Telegram/WhatsApp un chat_id/teléfono que no
// está vinculado a ningún Usuario — no hay con qué cliente/sede asociarlo de forma
// segura (ver webhook.service.ts, CONTACTO_NO_IDENTIFICADO), así que en vez de crear
// algo automáticamente se le piden 5 datos básicos por chat (sin IA, un campo a la
// vez, el primero vacío en orden) y un Coordinador/Admin decide manualmente a qué
// cliente real pertenece desde /admin/contactos-pendientes. `empresaReportada` es
// SOLO una referencia en pantalla — nunca se usa para matchear automáticamente contra
// un Cliente real, por el mismo riesgo de mezclar datos entre clientes que ya se
// descartó para el flujo de "Crear ticket interno".
model ContactoPendiente {
  id                 String                  @id @default(cuid())
  canal              String
  identificador      String
  nombre             String?
  empresaReportada   String?
  telefonoReportado  String?
  correoReportado    String?
  motivo             String?
  estado             EstadoContactoPendiente @default(RECOLECTANDO)
  ticketId           String?                 @unique
  ticket             Ticket?                 @relation(fields: [ticketId], references: [id])
  contactoCreadoId   String?
  contactoCreado     Usuario?                @relation(fields: [contactoCreadoId], references: [id])
  fechaCreacion      DateTime                @default(now())
  fechaActualizacion DateTime                @updatedAt

  notificaciones Notificacion[]

  @@index([canal, identificador])
  @@index([estado])
  @@map("contactos_pendientes")
}

// Vinculación de identidad vía chat (ver vinculacion-identidad.service.ts): cuando
// alguien escribe y no matchea por whatsappTelefono/telegramChatId/
// whatsappIdentificadorAlterno, se le pide su correo y se le manda un código de un solo
// uso por email — si lo confirma, se vincula el identificador de ESE canal al Usuario
// correspondiente. Fila efímera: se borra apenas se resuelve (vinculado, vencido,
// demasiados intentos fallidos, o el correo no pertenece a nadie).
model VerificacionIdentidadChat {
  id            String   @id @default(cuid())
  canal         String
  identificador String
  usuarioId     String?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  codigo        String?
  intentos      Int      @default(0)
  expiraEn      DateTime

  @@index([canal, identificador])
  @@map("verificaciones_identidad_chat")
}

enum TipoNotificacion {
  TICKET_SIN_ASIGNAR
  TICKET_ASIGNADO
  CONTACTO_PENDIENTE_NUEVO
  TICKET_CAMBIO_ESTADO
  TAREA_ASIGNADA
  TAREA_COMENTARIO
  TAREA_MENCION
}

// Feed de la campanita de notificaciones (NotificationBell) — una fila por
// destinatario, nunca compartida entre usuarios, para que "leída" sea individual. No
// reemplaza los webhooks de n8n (correo/Telegram/WhatsApp) ni los sustituye: es el
// mismo tipo de evento, mostrado también dentro de la propia app.
model Notificacion {
  id                  String             @id @default(cuid())
  usuarioId           String
  usuario             Usuario            @relation(fields: [usuarioId], references: [id])
  tipo                TipoNotificacion
  titulo              String
  mensaje             String
  ticketId            String?
  ticket              Ticket?            @relation(fields: [ticketId], references: [id])
  contactoPendienteId String?
  contactoPendiente   ContactoPendiente? @relation(fields: [contactoPendienteId], references: [id])
  leida               Boolean            @default(false)
  fechaCreacion       DateTime           @default(now())

  @@index([usuarioId, leida])
  @@map("notificaciones")
}
