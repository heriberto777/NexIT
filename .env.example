# PostgreSQL — usado por Prisma (prisma/schema.prisma)
# En producción (docker-compose.prod.yml, red externa "dev-network"), el host es el
# nombre del contenedor del servicio central: postgres-core.
# Corriendo el proyecto fuera de Docker (npm run dev en el host), usa localhost y
# el puerto publicado por postgres-core en tu máquina.
DATABASE_URL="postgresql://postgres:postgres@postgres-core:5432/nexit_db?schema=public"

# Redis — servicio central compartido (redis-core) en la misma red "dev-network".
# Aún no usado por el código; placeholder para cache de sesiones/rate limiting futuro.
REDIS_URL="redis://redis-core:6379"

# ---------- Solo para docker-compose.yml (desarrollo local en Docker) ----------
# DATABASE_URL/REDIS_URL de arriba no aplican dentro de ese contenedor (127.0.0.1/
# postgres-core no resuelven ahí) — docker-compose.yml arma su propia URL con
# host.docker.internal a partir de estas variables. No hacen falta si usas
# `npm run dev` directo en el host.
NEXIT_DB_USER="postgres"
NEXIT_DB_PASSWORD="postgres"
NEXIT_DB_NAME="nexit_db"
# Puerto publicado en el host para el contenedor de desarrollo (evita chocar con el
# 3000 si ya tienes otro proyecto usándolo).
NEXIT_PORT="3001"

# ---------- Solo para docker-compose.prod.yml (producción, imagen desde GHCR) ----------
# Casi nunca hace falta tocar estos tres — los defaults ya apuntan a la imagen
# publicada por .github/workflows/deploy-prod.yml. Ajusta IMAGE_TAG si quieres fijar
# una versión específica en vez de seguir "latest".
REGISTRY="ghcr.io"
GITHUB_REPOSITORY_OWNER="heriberto777"
IMAGE_TAG="latest"

# ---------- Autenticación (Auth.js / NextAuth v5) ----------
# Genera uno propio por entorno, nunca reuses este valor: `openssl rand -base64 32`
AUTH_SECRET=""
# URL pública donde corre la app — necesaria detrás de un reverse proxy (Docker/VPS)
# para que Auth.js arme correctamente las cookies y los callbacks.
NEXTAUTH_URL="http://localhost:3000"

# Dev-only: permite impersonar cualquier usuario sembrado sin loguearse de verdad
# (selector rápido en /admin y /portal). NUNCA debe estar en "true" en producción —
# session.ts revisa este flag explícitamente, independiente de NODE_ENV.
ALLOW_DEV_IMPERSONATION="true"

# ---------- Almacenamiento de archivos (evidencias, firmas, reportes) ----------
# "local" (default) escribe en public/uploads — ideal para un despliegue ligero en
# Docker/VPS con el volumen ya configurado en docker-compose.yml.
# "s3" habla el protocolo S3 (AWS S3, Cloudflare R2 o MinIO) vía @aws-sdk/client-s3.
STORAGE_PROVIDER="local"

# Solo si STORAGE_PROVIDER="s3":
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Vacío para AWS S3 real. Para MinIO/R2, la URL del endpoint S3-compatible:
S3_ENDPOINT=""
# MinIO normalmente necesita path-style ("true"); AWS S3/R2 no.
S3_FORCE_PATH_STYLE="false"
# Si el bucket/CDN sirve archivos públicamente, la URL base para armar el link directo
# sin firmar (ej. "https://cdn.tuempresa.com" o el dominio público de R2). Si se deja
# vacío, cada lectura genera una URL firmada temporal (1h) en vez de un link fijo.
S3_PUBLIC_BASE_URL=""

# ---------- Webhooks / notificaciones (n8n, email vía SMTP en el propio flujo de n8n) ----------
# URL del Webhook node de n8n que recibe TICKET_CREADO, TICKET_CAMBIO_ESTADO y
# SLA_EN_RIESGO. Vacío desactiva el envío por completo (los eventos se descartan
# silenciosamente) — util en dev/local donde no hay n8n corriendo.
WEBHOOK_N8N_URL=""
# Firma cada request saliente (header X-NexIT-Signature, HMAC SHA-256 del body) y
# además viaja como Bearer token — usa el que le resulte mas simple de validar al
# Webhook node de n8n. El mismo secreto protege POST /api/cron/sla-check.
WEBHOOK_SECRET=""
