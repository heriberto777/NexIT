      "id": "contexto-tecnico",
      "name": "Contexto técnico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.autorizado}}",
              "rightValue": true,
              "operator": {
