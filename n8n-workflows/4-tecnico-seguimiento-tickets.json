    {
      "parameters": {
        "method": "GET",
        "url": "https://nexit.tuempresa.com/api/n8n/tecnico/contexto",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "canal",
              "value": "={{ $json.canal }}"
